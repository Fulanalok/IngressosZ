rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated()
        && request.auth.token.keys().hasAny(['role'])
        && request.auth.token.role == role;
    }

    function isAdmin() {
      return isAuthenticated()
        && ((request.auth.token.keys().hasAny(['admin'])
            && request.auth.token.admin == true)
          || hasRole('admin'));
    }

    function isOrganizer() {
      return hasRole('organizer');
    }

    function isValidator() {
      return hasRole('validator');
    }

    function ownsEventData(eventData) {
      return isOrganizer() && eventData.organizerId == request.auth.uid;
    }

    function ownsEvent(eventId) {
      return isOrganizer()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId))
          .data.organizerId == request.auth.uid;
    }

    function isAssignedValidator(eventId) {
      let assignment = get(
        /databases/$(database)/documents/events/$(eventId)/validators/$(request.auth.uid)
      );
      return isValidator()
        && assignment.data.active == true
        && assignment.data.userId == request.auth.uid;
    }

    function eventFieldsAreValid() {
      return request.resource.data.keys().hasOnly([
          'title',
          'description',
          'date',
          'time',
          'location',
          'address',
          'price',
          'maxTickets',
          'maxPerPurchase',
          'availableTickets',
          'soldTickets',
          'inventory',
          'pricing',
          'image',
          'category',
          'organizerId',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.location is string
        && request.resource.data.address is string
        && request.resource.data.category is string
        && request.resource.data.organizerId is string
        && request.resource.data.createdBy is string
        && request.resource.data.price is number
        && request.resource.data.maxTickets is int
        && request.resource.data.availableTickets is int
        && request.resource.data.price >= 0
        && request.resource.data.maxTickets >= 0
        && request.resource.data.availableTickets >= 0
        && request.resource.data.availableTickets <= request.resource.data.maxTickets
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!('maxPerPurchase' in request.resource.data)
          || (request.resource.data.maxPerPurchase is number
            && request.resource.data.maxPerPurchase > 0))
        && (!('soldTickets' in request.resource.data)
          || (request.resource.data.soldTickets is int
            && request.resource.data.soldTickets >= 0
            && request.resource.data.soldTickets <= request.resource.data.maxTickets))
        && (!('inventory' in request.resource.data)
          || request.resource.data.inventory is map)
        && (!('pricing' in request.resource.data)
          || request.resource.data.pricing is map)
        && (!('image' in request.resource.data)
          || request.resource.data.image is string);
    }

    function eventInitialStockIsValid() {
      return request.resource.data.availableTickets
          == request.resource.data.maxTickets
        && (!('soldTickets' in request.resource.data)
          || request.resource.data.soldTickets == 0);
    }

    function eventIdentityIsUnchanged() {
      return request.resource.data.organizerId == resource.data.organizerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function onlyEditableEventFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'date',
        'time',
        'location',
        'address',
        'image',
        'category',
        'updatedAt'
      ]);
    }

    function authEmailMatches(email) {
      return !(email is string)
        || !request.auth.token.keys().hasAny(['email'])
        || email == request.auth.token.email;
    }

    function isValidPaymentSessionCreate() {
      return request.resource.data.keys().hasOnly([
          'eventId',
          'userId',
          'userEmail',
          'ticketType',
          'quantity',
          'unitPrice',
          'totalAmount',
          'status',
          'provider',
          'paymentMethod',
          'createdAt'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userEmail is string
        && authEmailMatches(request.resource.data.userEmail)
        && request.resource.data.ticketType is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice >= 0
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount
          == request.resource.data.unitPrice * request.resource.data.quantity
        && request.resource.data.status == 'pending'
        && request.resource.data.provider == 'mercadopago'
        && (!('paymentMethod' in request.resource.data)
          || request.resource.data.paymentMethod == 'pix'
          || request.resource.data.paymentMethod == 'checkout')
        && request.resource.data.createdAt is timestamp;
    }

    function ticketBelongsToUser(userId, ticketId) {
      return exists(/databases/$(database)/documents/tickets/$(ticketId))
        && get(/databases/$(database)/documents/tickets/$(ticketId))
          .data.userId == userId;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /validators/{userId} {
        allow read: if isAdmin()
          || (isAssignedValidator(eventId) && request.auth.uid == userId);
        allow create, update, delete: if false;
      }

      match /participants/{participantId} {
        allow read: if isAdmin() || ownsEvent(eventId);
        allow write: if false;
      }
    }

    match /tickets/{ticketId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.userId
          || isAdmin()
          || ownsEvent(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /paymentSessions/{sessionId} {
      allow create: if isAuthenticated() && isValidPaymentSessionCreate();
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
          || isAdmin()
          || ownsEvent(resource.data.eventId));
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /users/{userId}/purchasedTickets/{purchasedTicketId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ticketId', 'eventId', 'purchaseDate'
        ])
        && request.resource.data.ticketId is string
        && purchasedTicketId == request.resource.data.ticketId
        && request.resource.data.eventId is string
        && request.resource.data.purchaseDate is timestamp
        && ticketBelongsToUser(userId, request.resource.data.ticketId)
        && request.resource.data.eventId == get(
          /databases/$(database)/documents/tickets/$(request.resource.data.ticketId)
        ).data.eventId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'createdAt', 'role', 'avatarUrl'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.role == 'user'
        && (!('email' in request.resource.data)
          || authEmailMatches(request.resource.data.email));
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'avatarUrl'
        ]);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
