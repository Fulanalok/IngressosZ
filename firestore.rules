rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    function isOrganizer() {
      return isAdmin() || getRole() == 'organizer';
    }
    
    function isValidator() {
      return isOrganizer() || getRole() == 'validator';
    }

    // --- Events Collection ---
    // Anyone can read events. 
    // Only organizers can write (create/update) THEIR OWN events.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isOrganizer() && request.resource.data.organizerId == request.auth.uid;
      allow update: if (isOrganizer() && resource.data.organizerId == request.auth.uid) || isAdmin();
      allow delete: if (isOrganizer() && resource.data.organizerId == request.auth.uid) || isAdmin();
    }

    // --- Tickets Collection ---
    // Creation: Denied from client. Must be done by backend after payment.
    // Read: Users can read their own tickets. Validators can read any ticket.
    // Update: Only validators can update, and only specific fields for validation.
    match /tickets/{ticketId} {
      allow create: if false; // CRITICAL: Tickets must only be created by the backend.
      allow read: if isOwner(resource.data.userId) || isValidator();
      allow update: if isValidator() && 
                       request.resource.data.keys().hasOnly(['status', 'usedAt', 'validatedBy']);
      allow delete: if isAdmin();
    }
    
    // --- Users Collection ---
    // Users can read/update their own profiles.
    // Organizers can read user details (for guest lists).
    // Admins have full access.
    match /users/{userId} {
      allow read: if isOwner(userId) || isOrganizer();
      // Prevent users from changing their own roles.
      allow create: if isOwner(userId);
      // Allow update if user is owner AND is NOT changing the role (role must remain the same)
      // OR if user is admin.
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Payment Sessions Collection ---
    // Creation/Update: Denied from client. Must be handled by backend.
    // Read: Users can read their own payment sessions to check status.
    match /paymentSessions/{sessionId} {
      allow create: if false; // Backend function creates this.
      allow update: if false; // Backend webhook updates this.
      allow read: if isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
    
    // --- Default Deny ---
    // Explicitly deny access to any other collections by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
