rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to identify the application owner.
    // **IMPORTANT**: Replace 'YOUR_APPLICATION_OWNER_UID_HERE' with the actual UID of your application owner.
    // A more scalable approach for multiple owners or roles is to use Firebase Custom Claims.
    // Example using Custom Claims: return isAuthenticated() && request.auth.token.isOwner == true;
    function isOwner() {
      return isAuthenticated()
        && (
          (request.auth.token.keys().hasAny(['admin'])
            && request.auth.token.admin == true)
          || (request.auth.token.keys().hasAny(['role'])
            && (request.auth.token.role == "admin"
              || request.auth.token.role == "organizer"))
        );
    }


    // --- 1. Rules for the '/events' Collection ---
    // This collection holds master data for all events.
    match /events/{eventId} {
      allow read: if true;

      allow create: if isOwner()
        || (isAuthenticated()
          && request.resource.data.createdBy == request.auth.uid);

      allow update, delete: if isOwner()
        || (isAuthenticated()
          && resource.data.createdBy == request.auth.uid);
    }


    // --- 2. Rules for the '/tickets' Collection ---
    // This collection represents individual tickets that can be purchased.
    // Each ticket document should contain:
    // - eventId (string): ID of the event it belongs to.
    // - ownerId (string): UID of the application owner.
    // - isSold (boolean): True if sold, false otherwise.
    // - purchasedBy (string, optional): UID of the customer who bought it.
    match /tickets/{ticketId} {
      allow create: if isOwner();

      allow update, delete: if isOwner();

      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.userId || isOwner());
    }

    match /paymentSessions/{sessionId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isOwner());
      allow update, delete: if isOwner();
    }


    // --- 3. Rules for the '/users/{userId}/purchasedTickets' Subcollection ---
    // This subcollection under each user's document stores a record of tickets they have bought.
    match /users/{userId}/purchasedTickets/{purchasedTicketId} {
      // Customers can ONLY read their own purchased tickets.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // When a customer successfully buys a ticket (via the '/tickets' rule or a Cloud Function),
      // a corresponding record is created in their '/purchasedTickets' subcollection.
      allow create: if isAuthenticated()
                     && request.auth.uid == userId // Ensure the user is writing to their own subcollection
                     // Basic validation for required fields and types in the purchase record.
                     && request.resource.data.ticketId is string
                     && request.resource.data.eventId is string
                     && request.resource.data.purchaseDate is timestamp
                     // Ensure only expected fields are written.
                     && request.resource.data.keys().hasAll(['ticketId', 'eventId', 'purchaseDate'])
                     && request.resource.data.size() == 3;

      // Customers cannot update or delete their purchased ticket records directly.
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId || isOwner());
      allow create: if isAuthenticated()
        && request.auth.uid == userId;
      allow update: if isAuthenticated()
        && request.auth.uid == userId;
      allow delete: if isOwner();
    }


    // --- 4. Default Rule for All Other Collections ---
    // Deny all read/write access to any other collections not explicitly defined above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
