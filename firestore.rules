rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to identify the application owner.
    // **IMPORTANT**: Replace 'YOUR_APPLICATION_OWNER_UID_HERE' with the actual UID of your application owner.
    // A more scalable approach for multiple owners or roles is to use Firebase Custom Claims.
    // Example using Custom Claims: return isAuthenticated() && request.auth.token.isOwner == true;
    function isOwner() {
      return isAuthenticated() && request.auth.uid == 'YOUR_APPLICATION_OWNER_UID_HERE';
    }


    // --- 1. Rules for the '/events' Collection ---
    // This collection holds master data for all events.
    match /events/{eventId} {
      // The application owner can create, read, update, and delete any event.
      allow write: if isOwner(); // 'write' covers create, update, and delete.

      // Anyone (even unauthenticated users) can read event details to browse what's available.
      allow read: if true;

      // When an owner creates an event, validate the data.
      allow create: if isOwner()
                     // Ensure the ownerId field is correctly set to the creator's UID.
                     && request.resource.data.ownerId == request.auth.uid
                     // Basic validation for required fields and types.
                     && request.resource.data.name is string
                     && request.resource.data.date is timestamp
                     && request.resource.data.price is number
                     && request.resource.data.location is string
                     && request.resource.data.totalTickets is number
                     && request.resource.data.keys().hasAll(['ownerId', 'name', 'date', 'price', 'location', 'totalTickets']);

      // When an owner updates an event, prevent them from changing ownership.
      allow update: if isOwner()
                     && resource.data.ownerId == request.auth.uid;
    }


    // --- 2. Rules for the '/tickets' Collection ---
    // This collection represents individual tickets that can be purchased.
    // Each ticket document should contain:
    // - eventId (string): ID of the event it belongs to.
    // - ownerId (string): UID of the application owner.
    // - isSold (boolean): True if sold, false otherwise.
    // - purchasedBy (string, optional): UID of the customer who bought it.
    match /tickets/{ticketId} {
      // The application owner can create, update, and delete any ticket.
      allow write: if isOwner();

      // Anyone (even unauthenticated users) can read available tickets to browse.
      allow read: if true;

      // Customer 'buying' a ticket:
      // An authenticated non-owner can perform a very specific update operation.
      allow update: if isAuthenticated()
                     && !isOwner() // Must not be the owner
                     && resource.data.isSold == false // The ticket must currently be unsold
                     && request.resource.data.isSold == true // The update must set 'isSold' to true
                     && request.resource.data.purchasedBy == request.auth.uid // The update must assign it to the current user's UID
                     // Ensure ONLY 'isSold' and 'purchasedBy' fields are changed by the customer.
                     && request.resource.diff(resource).affectedKeys().hasOnly(['isSold', 'purchasedBy']);
    }


    // --- 3. Rules for the '/users/{userId}/purchasedTickets' Subcollection ---
    // This subcollection under each user's document stores a record of tickets they have bought.
    match /users/{userId}/purchasedTickets/{purchasedTicketId} {
      // Customers can ONLY read their own purchased tickets.
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // When a customer successfully buys a ticket (via the '/tickets' rule or a Cloud Function),
      // a corresponding record is created in their '/purchasedTickets' subcollection.
      allow create: if isAuthenticated()
                     && request.auth.uid == userId // Ensure the user is writing to their own subcollection
                     // Basic validation for required fields and types in the purchase record.
                     && request.resource.data.ticketId is string
                     && request.resource.data.eventId is string
                     && request.resource.data.purchaseDate is timestamp
                     // Ensure only expected fields are written.
                     && request.resource.data.keys().hasAll(['ticketId', 'eventId', 'purchaseDate'])
                     && request.resource.data.size() == 3;

      // Customers cannot update or delete their purchased ticket records directly.
      allow update, delete: if false;
    }


    // --- 4. Default Rule for All Other Collections ---
    // Deny all read/write access to any other collections not explicitly defined above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
