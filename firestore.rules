rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentAuthorization() {
      return get(
        /databases/$(database)/documents/authorization/$(request.auth.uid)
      );
    }

    function hasCurrentRole(role) {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['role', 'roleVersion'])
        && request.auth.token.roleVersion is int
        && request.auth.token.roleVersion > 0
        && currentAuthorization().data.status == 'active'
        && currentAuthorization().data.role == role
        && currentAuthorization().data.roleVersion
          == request.auth.token.roleVersion
        && request.auth.token.role == role
        && (
          (role == 'admin'
            && request.auth.token.keys().hasAll(['admin'])
            && request.auth.token.admin == true)
          || (role != 'admin'
            && (!request.auth.token.keys().hasAny(['admin'])
              || request.auth.token.admin != true))
        );
    }

    function isCurrentAdmin() {
      return hasCurrentRole('admin');
    }

    function isCurrentOrganizer() {
      return hasCurrentRole('organizer');
    }

    function isCurrentValidator() {
      return hasCurrentRole('validator');
    }

    function authEmailMatches(email) {
      return !(email is string)
        || !request.auth.token.keys().hasAny(['email'])
        || email == request.auth.token.email;
    }

    function ownsEvent(eventId) {
      return isCurrentOrganizer()
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId))
          .data.organizerId == request.auth.uid;
    }

    function isAssignedValidator(eventId) {
      let assignment = get(
        /databases/$(database)/documents/events/$(eventId)/validators/$(request.auth.uid)
      );
      return isCurrentValidator()
        && assignment.data.active == true
        && assignment.data.userId == request.auth.uid;
    }

    function ticketBelongsToUser(userId, ticketId) {
      return exists(/databases/$(database)/documents/tickets/$(ticketId))
        && get(/databases/$(database)/documents/tickets/$(ticketId))
          .data.userId == userId;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if false;

      match /validators/{userId} {
        allow read: if isCurrentAdmin()
          || (isAssignedValidator(eventId) && request.auth.uid == userId);
        allow create, update, delete: if false;
      }

      match /participants/{participantId} {
        allow read: if isCurrentAdmin() || ownsEvent(eventId);
        allow write: if false;
      }
    }

    match /tickets/{ticketId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.userId
          || isCurrentAdmin()
          || ownsEvent(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /paymentSessions/{sessionId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid
          || isCurrentAdmin()
          || ownsEvent(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /paymentWebhookEvents/{paymentId} {
      allow read, create, update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /users/{userId}/purchasedTickets/{purchasedTicketId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'ticketId', 'eventId', 'purchaseDate'
        ])
        && request.resource.data.ticketId is string
        && purchasedTicketId == request.resource.data.ticketId
        && request.resource.data.eventId is string
        && request.resource.data.purchaseDate is timestamp
        && ticketBelongsToUser(userId, request.resource.data.ticketId)
        && request.resource.data.eventId == get(
          /databases/$(database)/documents/tickets/$(request.resource.data.ticketId)
        ).data.eventId;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == userId || isCurrentAdmin());
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'phone', 'createdAt', 'role', 'avatarUrl'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && request.resource.data.role == 'user'
        && (!('email' in request.resource.data)
          || authEmailMatches(request.resource.data.email));
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'avatarUrl'
        ]);
      allow delete: if isCurrentAdmin();
    }

    match /authorization/{userId} {
      allow read, write: if false;

      match /operations/{operationId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
