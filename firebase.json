{
  "firestore": {
    "database": "(default)",
    "location": "southamerica-east1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/functions/mercadoPagoCreatePreference",
        "function": {
          "functionId": "mercadoPagoCreatePreference",
          "region": "us-central1"
        }
      },
      {
        "source": "/functions/mercadoPagoWebhook",
        "function": {
          "functionId": "mercadoPagoWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "/functions/validateTicket",
        "function": {
          "functionId": "validateTicket",
          "region": "us-central1"
        }
      },
      {
        "source": "/functions/seedTestData",
        "function": {
          "functionId": "seedTestData",
          "region": "us-central1"
        }
      },
      {
        "source": "/functions/health",
        "function": {
          "functionId": "health",
          "region": "us-central1"
        }
      },
      {
        "source": "/functions/logClientError",
        "function": {
          "functionId": "logClientError",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 5001,
      "host": "0.0.0.0"
    },
    "firestore": {
      "port": 8080,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "host": "0.0.0.0"
    },
    "singleProjectMode": true
  }
}
