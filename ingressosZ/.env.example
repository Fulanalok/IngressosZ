# Firebase Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Functions
VITE_FUNCTIONS_REGION=southamerica-east1

# Mercado Pago
VITE_MERCADOPAGO_PUBLIC_KEY=your_mercado_pago_public_key

# reCAPTCHA v2 used on login/signup
VITE_RECAPTCHA_V2_SITE_KEY=your_recaptcha_v2_site_key

# Firebase App Check with reCAPTCHA Enterprise
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=your_app_check_recaptcha_enterprise_key
VITE_APPCHECK_DEBUG_TOKEN=false

# Local emulators
VITE_USE_EMULATORS=false
VITE_FUNCTIONS_PORT=5001
VITE_FIREBASE_EMULATOR_FUNCTIONS_PORT=5001
VITE_FIREBASE_EMULATOR_AUTH_PORT=9099
VITE_FIREBASE_EMULATOR_FIRESTORE_PORT=8086
VITE_FIREBASE_EMULATOR_STORAGE_PORT=9199

# Monitoring
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Public legal/contact information shown on Terms and Privacy pages
VITE_LEGAL_BRAND_NAME=IngressosZ
VITE_LEGAL_CONTROLLER_NAME=your_company_or_responsible_name
VITE_LEGAL_CONTROLLER_DOCUMENT=your_cnpj_or_cpf
VITE_LEGAL_CONTROLLER_ADDRESS=your_public_business_address
VITE_LEGAL_SUPPORT_EMAIL=support@example.com
VITE_LEGAL_PRIVACY_EMAIL=privacy@example.com
VITE_LEGAL_DPO_NAME=Privacy contact
