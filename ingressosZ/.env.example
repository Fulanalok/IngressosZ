# Frontend (.env.example)

############################################################
# Firebase Configuration
#
# Preencha com os valores do seu projeto Firebase.
# Exemplo abaixo usa nomes padrão do projeto "ingressosz".
############################################################
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=ingressosz.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ingressosz
VITE_FIREBASE_STORAGE_BUCKET=ingressosz.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXX

############################################################
# Cloud Functions URL (opcional)
#
# Se vazio, o app calcula automaticamente:
#  • Dev:  http://localhost:5001/<projectId>/us-central1
#  • Prod: https://us-central1-<projectId>.cloudfunctions.net
#
# Você pode definir manualmente se precisar customizar.
############################################################
VITE_FUNCTIONS_URL=

############################################################
# Emuladores (apenas desenvolvimento)
#
# Dev:    true  → conecta no Auth (9099), Firestore (8080) e Functions (5001)
# Prod:   false → usa serviços reais do Firebase
############################################################
VITE_USE_EMULATORS=true
