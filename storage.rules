rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function hasRole(role) {
      return isAuthenticated() && 
             (request.auth.token.role == role || request.auth.token.admin == true);
    }
    
    function isOrganizer() {
      return hasRole('organizer') || hasRole('admin');
    }

    // --- Event Images ---
    // Public read access for event images
    // Only organizers/admins can upload
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isOrganizer();
    }
    
    // --- User Profile Images (future proofing) ---
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
