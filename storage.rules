rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function currentAuthorization() {
      return firestore.get(
        /databases/(default)/documents/authorization/$(request.auth.uid)
      );
    }

    function hasCurrentRole(role) {
      return isAuthenticated()
        && request.auth.token.keys().hasAll(['role', 'roleVersion'])
        && request.auth.token.roleVersion is int
        && request.auth.token.roleVersion > 0
        && currentAuthorization().data.status == 'active'
        && currentAuthorization().data.role == role
        && currentAuthorization().data.roleVersion
          == request.auth.token.roleVersion
        && request.auth.token.role == role
        && (
          (role == 'admin'
            && request.auth.token.keys().hasAll(['admin'])
            && request.auth.token.admin == true)
          || (role != 'admin'
            && (!request.auth.token.keys().hasAny(['admin'])
              || request.auth.token.admin != true))
        );
    }

    function isCurrentOrganizer() {
      return hasCurrentRole('organizer') || hasCurrentRole('admin');
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isValidImageUpload(maxSizeMb) {
      return isImage()
        && request.resource.size < maxSizeMb * 1024 * 1024;
    }

    // --- Event Images ---
    // Public read access for event images
    // Only organizers/admins can upload
    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isCurrentOrganizer() && isValidImageUpload(5);
    }
    
    // --- User Profile Images (future proofing) ---
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.auth.uid == userId
        && isValidImageUpload(5);
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
