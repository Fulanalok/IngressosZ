# Mercado Pago secrets. Configure real values with:
# firebase functions:secrets:set MP_ACCESS_TOKEN
# firebase functions:secrets:set MP_WEBHOOK_SECRET
MP_ACCESS_TOKEN=replace_with_secret_manager_value
MP_WEBHOOK_SECRET=replace_with_secret_manager_value

# Security secrets. Configure real values with Secret Manager too.
JWT_SECRET=replace_with_secret_manager_value
RECAPTCHA_V2_SECRET=replace_with_secret_manager_value

# Email Service Params
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=sender@example.com

# Email service secret
SMTP_PASSWORD=replace_with_secret_manager_value

# Public runtime params
WEB_BASE_URL=http://localhost:5173

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
