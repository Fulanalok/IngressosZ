# Backend (.env.example)

# Firebase Functions Environment Variables
# Copy this file to .env and fill in your values for local development

# ============================================
# MERCADO PAGO
# ============================================
# Access Token (obtenha em https://www.mercadopago.com.br/developers/panel/credentials)
# Use TEST para testes, PRODUCTION para produção
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN_HERE

# URL do webhook para receber notificações de pagamento (opcional)
# Local: deixe vazio para usar o padrão
# Produção: configure após deploy
MP_WEBHOOK_URL=
# Token secreto para validar o webhook do Mercado Pago
MP_WEBHOOK_TOKEN=

# ============================================
# CORS / Origem do Frontend
# ============================================
# Várias origens suportadas, separadas por vírgula
ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173
# Origem padrão usada em callbacks do Mercado Pago (back_urls)
FRONTEND_URL=https://localhost:5173

# ============================================
# Emulador de Functions
# ============================================
# O Firebase CLI normalmente define isso automaticamente ao usar emuladores.
# Se necessário, você pode forçar manualmente.
FUNCTIONS_EMULATOR=false

# ============================================
# Produção (habilitar endpoints)
# ============================================
# Por padrão os endpoints funcionam apenas no emulador.
# Defina como true para habilitar em produção quando necessário.
ENABLE_PROD_FUNCTIONS=false
