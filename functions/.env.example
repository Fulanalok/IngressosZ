# Mercado Pago Secrets
MP_ACCESS_TOKEN=your_mercado_pago_access_token
MP_WEBHOOK_SECRET=your_mercado_pago_webhook_secret

# Security Secrets
JWT_SECRET=your_long_random_jwt_secret_key_here
RECAPTCHA_V2_SECRET=your_recaptcha_v2_secret_key

# Email Service Params
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com

# Email Service Secrets
SMTP_PASSWORD=your_app_specific_password

# Public runtime params
WEB_BASE_URL=https://your-project.web.app

# Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0
