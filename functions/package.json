{
  "name": "functions",
  "type": "module",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && npx firebase-tools emulators:start --only functions --project demo-ingressosz --config ../firebase.json",
    "shell": "npm run build && npx firebase-tools functions:shell --project demo-ingressosz --config ../firebase.json",
    "start": "npm run shell",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --no-deprecation ./node_modules/mocha/bin/mocha -r ts-node/register --timeout 10000 --ignore \"src/test/webhook.e2e.test.ts\" --ignore \"src/test/maintenance.e2e.test.ts\" --ignore \"src/test/roleChange.e2e.test.ts\" \"src/test/**/*.test.ts\"",
    "test:webhook": "npm run build && node --no-deprecation ./node_modules/mocha/bin/mocha -r ts-node/register --timeout 20000 \"src/test/webhook.e2e.test.ts\"",
    "test:maintenance": "npm run build && node --no-deprecation ./node_modules/mocha/bin/mocha -r ts-node/register --timeout 20000 \"src/test/maintenance.e2e.test.ts\"",
    "test:roles": "npm run build && node --no-deprecation ./node_modules/mocha/bin/mocha -r ts-node/register --timeout 20000 \"src/test/roleChange.e2e.test.ts\"",
    "migrate:role-authorizations": "npm run build && node scripts/migrate-role-authorizations.mjs",
    "deploy": "npx firebase-tools deploy --only functions --config ../firebase.json",
    "logs": "npx firebase-tools functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@sentry/node": "^7.119.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.3",
    "mercadopago": "^2.2.3",
    "nodemailer": "^8.0.5",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "chai": "^4.4.1",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "firebase-functions-test": "^2.1.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "diff": "8.0.3",
    "serialize-javascript": "7.0.4"
  },
  "private": true
}
